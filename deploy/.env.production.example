# deploy/.env.production.example
# Copy to .env on the EC2 instance itself (never commit the real file).
# Differences from the root .env.example, and why:
#
#   ENV=production        instead of ENV=local
#     -- domains/banking/documents/settings.py defaults LLM_PROVIDER to
#        "openai" whenever ENV != "local". A free-tier t3.micro (1GB RAM)
#        cannot run Ollama + llama3.1:8b locally, and there's no host
#        Ollama to reach on a cloud VM anyway -- this one variable routes
#        banking documents to OpenAI for both the LLM and the reranker
#        (Cohere, if COHERE_API_KEY is set; gracefully skipped if not --
#        see retriever_agent.py's _rerank()) instead of the local
#        sentence-transformers/CrossEncoder path. No code change needed,
#        this is exactly what ENV was built for.
#
# Everything else is the same shape as the root .env.example.

# ── Shared ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
ENV=production

# ── banking fraud domain ────────────────────────────────────────────────
MODEL_NAME=gpt-4o-mini
RISK_THRESHOLD=50000

# ── banking documents domain ────────────────────────────────────────────
# LLM_PROVIDER intentionally omitted -- ENV=production above already
# resolves it to "openai". Set it explicitly here instead if you ever
# want to override that.
OPENAI_MODEL=gpt-4o-mini
COHERE_API_KEY=your-cohere-api-key-here
BANKING_COLLECTION_NAME=bank_statements
CHROMA_PATH=./vector_store
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Per-domain vector collections (each defaults sensibly if unset) ─────
INSURANCE_COLLECTION_NAME=insurance_claims
FINANCIAL_SERVICES_COLLECTION_NAME=fintech_statements
PAYROLL_COLLECTION_NAME=payroll_registers

# ── Public-site cost guards (ui/guard.py) ────────────────────────────────
# This site has no login and every action spends the OpenAI key. The
# defaults below are the built-in ones, listed so you can tighten them;
# ALSO set a monthly spend cap in the OpenAI dashboard as the hard stop.
# PRISM_LIMIT_INGEST_PER_HOUR=20
# PRISM_LIMIT_CHAT_PER_HOUR=60
# PRISM_DAILY_INGEST_BUDGET=300
# PRISM_DAILY_CHAT_BUDGET=1500
# Bound the fan-out of one upload into many LLM calls (every scored row that
# escapes the rules+ML tiers is one call). Built-in defaults are 5000 rows/day
# across all visitors and 2000 rows per CSV; tighten for a public demo:
# PRISM_DAILY_SCORED_ROWS_BUDGET=2000
# PRISM_MAX_CSV_ROWS=500
# The per-session limits above can't stop a visitor opening fresh sessions to
# use up the shared daily budgets, so if the URL is posted anywhere public
# and you don't want strangers spending your key, set an access code:
# PRISM_ACCESS_CODE=choose-something
