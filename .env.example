# .env.example — copy to .env and fill in real values. Never commit .env.

# ── Shared ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
ENV=local

# ── bfsi_fraud domain ────────────────────────────────────────────────
MODEL_NAME=gpt-4o-mini
RISK_THRESHOLD=50000

# ── bfsi_documents domain ────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
COHERE_API_KEY=your-cohere-api-key-here
COLLECTION_NAME=bank_statements
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
VECTOR_DB=chroma
QDRANT_API_KEY=your_actual_key_here
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
