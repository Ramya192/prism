# .env.example — copy to .env and fill in real values. Never commit .env.

# ── Shared, all 4 domains (banking, payroll_hr, insurance, financial_services) ──
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ENV=local

# ── Banking fraud tier (domains/banking/fraud) ──────────────────────────
MODEL_NAME=gpt-4o-mini
RISK_THRESHOLD=50000

# ── Document chat / RAG, all 4 domains ──────────────────────────────────
# LLM_PROVIDER=ollama (local dev default) needs Ollama running with
# OLLAMA_MODEL pulled; LLM_PROVIDER=openai is used in production
# (see requirements-local.txt for the extra install ollama needs).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
COHERE_API_KEY=your-cohere-api-key-here
CHROMA_PATH=./vector_store
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Per-domain vector collection names, one per domain (each defaults
# sensibly if unset -- only needed to avoid collisions with an existing
# collection of the same name in the same store)
BANKING_COLLECTION_NAME=bank_statements
INSURANCE_COLLECTION_NAME=insurance_claims
FINANCIAL_SERVICES_COLLECTION_NAME=fintech_statements
PAYROLL_COLLECTION_NAME=payroll_registers

# ── Public-deployment cost guards (ui/guard.py) — all optional; 0 disables ──
# Per-session hourly limits and all-visitor daily budgets on the actions
# that spend your OpenAI key. Defaults shown.
# PRISM_LIMIT_INGEST_PER_HOUR=20
# PRISM_LIMIT_CHAT_PER_HOUR=60
# PRISM_LIMIT_SCORE_PER_HOUR=60
# PRISM_DAILY_INGEST_BUDGET=300
# PRISM_DAILY_CHAT_BUDGET=1500
# PRISM_DAILY_SCORE_BUDGET=1500
# Set to require a shared access code before the app renders at all:
# PRISM_ACCESS_CODE=
# Parallel workers for scoring a CSV's rows (1 = serial):
# PRISM_SCORING_WORKERS=8
# Rows scored per day across ALL uploads, and per CSV upload. Each row that
# escapes the rules+ML tiers is one LLM call, so this bounds the worst-case
# daily spend that the upload budget above can't (default 5000; 0 disables):
# PRISM_DAILY_SCORED_ROWS_BUDGET=5000
# PRISM_MAX_CSV_ROWS=2000
